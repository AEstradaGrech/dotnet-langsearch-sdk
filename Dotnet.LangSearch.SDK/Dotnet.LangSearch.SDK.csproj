<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
  </ItemGroup>
	<PropertyGroup>
		<AssemblyName>Estrada.LangSearch.SDK</AssemblyName>
		<PackageId>Estrada.LangSearch.SDK</PackageId>
		<Version>0.2.0-alpha</Version>
		<AssemblyVersion>0.2.0.0</AssemblyVersion>
		<InformationalVersion>0.2.0-alpha</InformationalVersion>
		<Title>Dotnet LangSearch SDK</Title>
		<Authors>Alvaro Estrada</Authors>
		<Description>.Net SDK to work with LangSearch</Description>
		<PackageTags>web-search-tool</PackageTags>
		<PackageProjectUrl>https://github.com/AEstradaGrech/dotnet-langsearch-sdk</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/AEstradaGrech/dotnet-langsearch-sdk</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>
</Project>
